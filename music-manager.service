[Unit]
Description=Music Downloader & Tag Manager Service
After=network.target

[Service]
Type=simple
User=music
Group=music
WorkingDirectory=/opt/music-manager
EnvironmentFile=/opt/music-manager/.env
ExecStart=/opt/music-manager/bin/music-manager
UMask=0022
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
KillSignal=SIGTERM
KillMode=control-group

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/music-manager /var/lib/music

[Install]
WantedBy=multi-user.target
