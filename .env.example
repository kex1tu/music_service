# ==============================================================================
# Music Downloader & Tag Manager — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your deployment.
# Required settings: MUSIC_DIR, SECRET_KEY, ADMIN_PASSWORD_HASH
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Файловое хранилище (Storage Paths)
# ------------------------------------------------------------------------------
# [ОБЯЗАТЕЛЬНО] Абсолютный путь к постоянной медиатеке (куда складываются организованные треки)
# Пример для Linux / production: /var/lib/music-manager/music или /opt/music-manager/music_library
MUSIC_DIR=/path/to/music_library

# [ОПЦИОНАЛЬНО] Каталог временного буфера загрузок (по умолчанию: tmp_downloads)
# Относительный путь от корня приложения или абсолютный путь.
TMP_DIR=tmp_downloads

# [ОПЦИОНАЛЬНО] Путь к SQLite базе данных медиатеки (по умолчанию: data/library.db)
DATABASE_PATH=data/library.db

# ------------------------------------------------------------------------------
# 2. Безопасность и аутентификация (Security & Auth)
# ------------------------------------------------------------------------------
# [ОБЯЗАТЕЛЬНО] Секретный ключ для подписи session cookies (минимум 16 символов, рекомендуется 32+ байта hex)
# Генерация: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_secure_random_string_at_least_32_chars

# [ОПЦИОНАЛЬНО] Логин администратора (по умолчанию: admin)
ADMIN_LOGIN=admin

# [ОБЯЗАТЕЛЬНО] bcrypt-хэш пароля администратора (минимум 20 символов)
# Генерация: python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$e867... # Замените на реальный bcrypt-хэш

# [ОПЦИОНАЛЬНО] Время жизни сессии в секундах (по умолчанию: 604800 = 7 суток)
SESSION_TTL=604800

# [ОПЦИОНАЛЬНО] Имя cookie сессии (по умолчанию: music_manager_session)
SESSION_COOKIE_NAME=music_manager_session

# [ОПЦИОНАЛЬНО] Флаг Secure для cookie (по умолчанию: false).
# Установите в true, если сервис работает за HTTPS reverse-proxy (nginx/caddy).
SESSION_COOKIE_SECURE=false

# [ОПЦИОНАЛЬНО] Политика SameSite для cookie: strict | lax | none (по умолчанию: strict)
SESSION_COOKIE_SAMESITE=strict

# ------------------------------------------------------------------------------
# 3. Внешние сервисы и API (External Services)
# ------------------------------------------------------------------------------
# [ОПЦИОНАЛЬНО] OAuth токен Яндекс Музыки (для прямого скачивания 320 kbps MP3 без YouTube)
YANDEX_MUSIC_TOKEN=

# [ОПЦИОНАЛЬНО] HTTP/HTTPS или SOCKS5 прокси для запросов к Яндекс Музыке (обход ошибки HTTP 451 Geoblock при запуске на зарубежных VPS/серверах)
# Пример: http://user:pass@ru-proxy:8080 или socks5://127.0.0.1:1080
YANDEX_MUSIC_PROXY=

# [ОПЦИОНАЛЬНО] Spotify API Client ID & Client Secret (для официального Web API с пагинацией)
# Получить можно на: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# [ОПЦИОНАЛЬНО] HTTP/HTTPS прокси для Deezer API (при 403 со стороны Akamai WAF на серверных IP)
# Пример: http://user:pass@proxy-host:8080 или socks5://127.0.0.1:1080
# DEEZER_PROXY=

# ------------------------------------------------------------------------------
# 4. Аудио-пайплайн и загрузки (Audio & Downloader Pipeline)
# ------------------------------------------------------------------------------
# [ОПЦИОНАЛЬНО] Целевой битрейт при конвертации ffmpeg в MP3 CBR (по умолчанию: 320k)
AUDIO_BITRATE=320k

# [ОПЦИОНАЛЬНО] Частота дискретизации аудио в Гц (по умолчанию: 44100)
AUDIO_SAMPLE_RATE=44100

# [ОПЦИОНАЛЬНО] Максимальное количество параллельных фоновых загрузок (1-10, по умолчанию: 2)
MAX_CONCURRENT_DOWNLOADS=2

# [ОПЦИОНАЛЬНО] Максимальное количество параллельных запросов сопоставления треков AudioMatcher (1-10, по умолчанию: 4)
MATCHER_CONCURRENCY=6

# [ОПЦИОНАЛЬНО] Максимальное количество параллельно скачиваемых и конвертируемых треков внутри одного релиза (1-10, по умолчанию: 3)
TRACK_DOWNLOAD_CONCURRENCY=5

# [ОПЦИОНАЛЬНО] Приоритетное использование cookies без предварительной гостевой попытки (ускорение в 2 раза)
YTDLP_USE_COOKIES_FIRST=true

# [ОПЦИОНАЛЬНО] Время хранения временных файлов задач в часах до очистки (1-168, по умолчанию: 24)
JOB_TTL_HOURS=24

# [ОПЦИОНАЛЬНО] Путь к файлу cookies.txt для yt-dlp (обход возрастных ограничений YouTube).
# Если файл cookies.txt расположен в корне проекта или текущей директории, он обнаруживается автоматически.
# YTDLP_COOKIES_PATH=cookies.txt

# [ОПЦИОНАЛЬНО] Разрешенные домены для скачивания (JSON-массив, по умолчанию предустановлен в коде)
# ALLOWED_DOWNLOAD_DOMAINS='["youtube.com", "music.youtube.com", "youtu.be", "soundcloud.com", "deezer.com", "deezer.page.link", "link.deezer.com"]'

# ------------------------------------------------------------------------------
# 4b. BitTorrent / Торрент-загрузчик (aria2c)
# ------------------------------------------------------------------------------
# [ОПЦИОНАЛЬНО] Включить/выключить поддержку торрентов (по умолчанию: true)
TORRENT_ENABLED=true

# [ОПЦИОНАЛЬНО] Путь к исполняемому файлу aria2c (по умолчанию: aria2c, ищется в PATH)
# ARIA2C_PATH=aria2c

# [ОПЦИОНАЛЬНО] Начальный порт для входящих BitTorrent пиров (по умолчанию: 6881)
# TORRENT_PEER_PORT=6881

# [ОПЦИОНАЛЬНО] Время сидинга после завершения загрузки в минутах (по умолчанию: 0 = отключен)
# TORRENT_SEED_TIME=0

# [ОПЦИОНАЛЬНО] Максимальное количество пиров на задачу (по умолчанию: 55)
# TORRENT_MAX_PEERS=55

# [ОПЦИОНАЛЬНО] Таймаут ожидания пиров/метаданных торрента в секундах (по умолчанию: 300)
# TORRENT_TIMEOUT=300

# [ОПЦИОНАЛЬНО] Максимальный размер торрент-раздачи в ГБ (по умолчанию: 50)
# TORRENT_MAX_SIZE_GB=50

# ------------------------------------------------------------------------------
# 5. Сетевые параметры сервиса (Network & Server)
# ------------------------------------------------------------------------------
# [ОПЦИОНАЛЬНО] Хост привязки сокета Uvicorn (по умолчанию: 127.0.0.1)
HOST=127.0.0.1

# [ОПЦИОНАЛЬНО] Порт HTTP-сервера (по умолчанию: 8010)
PORT=8010

# [ОПЦИОНАЛЬНО] Режим отладки (по умолчанию: false)
DEBUG=false

# ------------------------------------------------------------------------------
# 6. Нативный Go-сканер медиатеки (Native Scanner)
# ------------------------------------------------------------------------------
# [ОПЦИОНАЛЬНО] Путь к скомпилированному бинарнику Go-сканера
# Если не указан, автоматически ищется в PROJECT_ROOT/bin/music-scanner
# MUSIC_SCANNER_BIN_PATH=bin/music-scanner
