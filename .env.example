# ==============================================================================
# Music Downloader & Tag Manager — Environment Configuration Example
# ==============================================================================

# Пути к файловому хранилищу
MUSIC_DIR=/path/to/music_library
TMP_DIR=tmp_downloads

# Безопасность и сессии
SECRET_KEY=change_me_to_a_secure_random_string_at_least_32_chars
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=$2b$12$e867... # bcrypt-хэш пароля администратора
SESSION_TTL=604800
SESSION_COOKIE_NAME=music_manager_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict

# Внешние сервисы (опционально)
GENIUS_API_TOKEN=

# Аудио-параметры (конвертация)
AUDIO_BITRATE=320k
AUDIO_SAMPLE_RATE=44100

# Сетевые настройки сервиса
HOST=127.0.0.1
PORT=8010
DEBUG=false
