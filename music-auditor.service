[Unit]
Description=Music Manager Go Audit & Catalog Daemon
After=network.target

[Service]
Type=simple
# User=music-manager
# Group=music-manager
WorkingDirectory=/opt/music-manager
ExecStart=/opt/music-manager/bin/music-scanner --root /var/lib/music-manager/music --db /opt/music-manager/data/library.db --daemon --auto-fix-genres=true --check-missing=true
Restart=always
RestartSec=5s
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# Hardening
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
